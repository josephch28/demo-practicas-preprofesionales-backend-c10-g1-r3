DATABASE_URL="postgresql://practicas:practicas@localhost:5432/practicas?schema=public"

# Secreto para firmar tokens JWT (obligatorio; la app no arrancará si falta).
# Generar uno seguro con: openssl rand -base64 32
JWT_SECRET="cambiame-en-produccion"

PORT=3000
CORS_ORIGIN="http://localhost:5173"

# Puerto en el que docker-compose publica Postgres. Si 5432 ya está ocupado en
# tu máquina, cámbialo aquí y en DATABASE_URL.
POSTGRES_PORT=5432

# Zona horaria IANA de la institución. Las fechas de HourLog se normalizan a
# esta zona horaria en el servidor (ver src/hour-log/timezone.ts), sin
# importar la zona horaria del dispositivo que registró la hora.
HOUR_LOG_TIME_ZONE="America/Guayaquil"
# Límites de un registro de horas por día (E6-01). Si falta o es inválido, se
# usan los defaults 0.5 y 8 definidos en src/hour-log/hour-log-rules.ts.
# El repo del frontend tiene sus pares VITE_HOUR_LOG_MIN/MAX; mantener en sincro.
#HOUR_LOG_MIN_HOURS_PER_DAY=0.5
#HOUR_LOG_MAX_HOURS_PER_DAY=8

# Registro de horas por voz (VOZ-08). Sin GROQ_API_KEY el endpoint
# POST /hour-logs/voice-draft responde 503 y el resto de la app funciona igual.
# Consigue una key en https://console.groq.com. No la subas a Git.
GROQ_API_KEY=
# Modelos opcionales. Verifica los nombres vigentes en la consola de Groq.
#GROQ_STT_MODEL=whisper-large-v3-turbo
#GROQ_LLM_MODEL=openai/gpt-oss-120b

#Variables de entorno de voz requeridas
AI_VOICE_API_KEY=
AI_VOICE_PROVIDER_URL=
